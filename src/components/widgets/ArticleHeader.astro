---
import { themeConfig } from '@/config'
import type { ReadingTime } from '@/types'

interface Props {
  title: string
  pubDate: Date | string
  tags?: string[]
  labels?: string[]
  label?: string
  author?: string
  readingTime?: ReadingTime
}

const {
  title,
  pubDate,
  tags = [],
  labels = [],
  label,
  author,
  readingTime
} = Astro.props

const allTags = Array.from(new Set([...tags, ...labels, ...(label ? [label] : [])]))
const authorName = author || themeConfig.site.author || 'Agra'

// Compute author initials (e.g. "Ananda Anugrah Ramadhan" -> "AR")
const nameParts = authorName.trim().split(/\s+/).filter(Boolean)
const authorInitials =
  nameParts.length > 1
    ? (nameParts[0][0] + nameParts[nameParts.length - 1][0]).toUpperCase()
    : (nameParts[0]?.slice(0, 2) || 'A').toUpperCase()

// Format date in editorial style: e.g. "23 May, 2025"
const dateObj = pubDate instanceof Date ? pubDate : new Date(pubDate)
const day = dateObj.getDate()
const monthName = dateObj.toLocaleDateString('en-US', { month: 'short' })
const year = dateObj.getFullYear()
const formattedDate = !isNaN(day) ? `${day} ${monthName}, ${year}` : ''

// Format reading time: e.g. "5 min read"
let readMinutes = 3
if (readingTime?.minutes) {
  readMinutes = Math.max(1, Math.round(readingTime.minutes))
} else if (readingTime?.text) {
  const match = readingTime.text.match(/\d+/)
  if (match) readMinutes = parseInt(match[0], 10)
}
const readingTimeText = `${readMinutes} min read`
---

<header class="article-header">
  {
    allTags.length > 0 && (
      <div class="category-wrapper">
        {allTags.map((t) => (
          <span class="category-pill">{t}</span>
        ))}
      </div>
    )
  }

  <h1 class="article-title">{title}</h1>

  <div class="editorial-byline">
    <div class="byline-author">
      <span class="byline-avatar" aria-hidden="true">{authorInitials}</span>
      <span class="byline-author-name">{authorName}</span>
    </div>

    <span class="byline-dot" aria-hidden="true">•</span>

    <time datetime={dateObj.toISOString()} class="byline-date">
      {formattedDate}
    </time>

    <span class="byline-dot" aria-hidden="true">•</span>

    <span class="byline-reading-time">
      {readingTimeText}
    </span>
  </div>
</header>

<style>
  .article-header {
    margin-bottom: 2.25rem;
  }

  /* Minimalist Category Pill Badge */
  .category-wrapper {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin-bottom: 1.125rem;
  }

  .category-pill {
    font-size: 0.6875rem !important;
    font-weight: 550;
    text-transform: uppercase;
    letter-spacing: 0.14em;
    color: var(--text-secondary);
    background-color: var(--code-bg);
    border: 1px solid var(--border);
    padding: 0.28rem 0.75rem !important;
    border-radius: 9999px;
    display: inline-flex;
    align-items: center;
    line-height: 1.35;
    transition: all 0.2s ease-out;
    user-select: none;
  }

  .category-pill:hover {
    color: var(--text-primary);
    border-color: var(--text-secondary);
  }

  /* Editorial Serif Large Title */
  .article-title {
    font-family: var(--serif) !important;
    font-size: clamp(2.125rem, 4.5vw, 2.875rem) !important;
    font-weight: 450 !important;
    font-variation-settings: 'wght' 450;
    line-height: 1.2 !important;
    letter-spacing: -0.015em !important;
    color: var(--text-primary) !important;
    margin: 0 0 1.25rem 0 !important;
    text-wrap: balance;
  }

  /* Warm Byline Flanked By Thin Divider Lines */
  .editorial-byline {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 0.625rem 0.75rem;
    padding: 0.875rem 0 !important;
    border-top: 1px solid var(--border) !important;
    border-bottom: 1px solid var(--border) !important;
    margin-top: 1.25rem !important;
    margin-bottom: 2.5rem !important;
    color: var(--text-secondary);
    font-size: 0.8125rem !important;
    line-height: 1.5;
  }

  .byline-author {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
  }

  .byline-avatar {
    width: 1.625rem;
    height: 1.625rem;
    border-radius: 50%;
    background-color: var(--code-bg);
    border: 1px solid var(--border);
    color: var(--text-primary);
    font-family: var(--sans);
    font-size: 0.625rem !important;
    font-weight: 600;
    letter-spacing: 0.04em;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
    user-select: none;
    box-shadow: 0 1px 2px rgba(0, 0, 0, 0.04);
  }

  .byline-author-name {
    font-weight: 500;
    color: var(--text-primary);
    font-size: 0.8125rem !important;
    letter-spacing: -0.005em;
  }

  .byline-dot {
    color: var(--text-tertiary);
    font-size: 0.625rem !important;
    user-select: none;
    opacity: 0.85;
  }

  .byline-date {
    color: var(--text-secondary);
    font-size: 0.8125rem !important;
  }

  .byline-reading-time {
    color: var(--text-secondary);
    font-size: 0.8125rem !important;
  }
</style>
