---
import type { PostListProps } from '@/types'

const {
  posts,
  moreHref,
  moreLabel = 'All posts',
  emptyText = 'No posts yet.'
} = Astro.props as PostListProps

const MONTHS = [
  'Jan',
  'Feb',
  'Mar',
  'Apr',
  'May',
  'Jun',
  'Jul',
  'Aug',
  'Sep',
  'Oct',
  'Nov',
  'Dec'
]

type Post = PostListProps['posts'][number]
type MonthGroup = { month: number; posts: Post[] }
type YearGroup = { year: number; months: MonthGroup[] }

// Group posts by year, then by month (preserving incoming sort order)
const groups: YearGroup[] = []
for (const post of posts) {
  const date = post.data.pubDate
  const year = date.getFullYear()
  const month = date.getMonth()

  let yearGroup = groups.find((g) => g.year === year)
  if (!yearGroup) {
    yearGroup = { year, months: [] }
    groups.push(yearGroup)
  }

  let monthGroup = yearGroup.months.find((m) => m.month === month)
  if (!monthGroup) {
    monthGroup = { month, posts: [] }
    yearGroup.months.push(monthGroup)
  }

  monthGroup.posts.push(post)
}

const pad = (n: number) => String(n).padStart(2, '0')
---

<div class="post-list">
  {
    groups.map((yearGroup) => (
      <section class="year-group" aria-labelledby={`year-${yearGroup.year}`}>
        <h2 class="year font-features" id={`year-${yearGroup.year}`}>
          {yearGroup.year}
        </h2>
        {yearGroup.months.map((monthGroup) => (
          <div class="month-group">
            <h3 class="month">{MONTHS[monthGroup.month]}</h3>
            <ul>
              {monthGroup.posts.map((post) => (
                <li>
                  <a href={`/${post.id}/`} class="post-item">
                    <span class="title">{post.data.title}</span>
                    <time class="day date" datetime={post.data.pubDate.toISOString()}>
                      {pad(post.data.pubDate.getDate())}
                    </time>
                  </a>
                </li>
              ))}
            </ul>
          </div>
        ))}
      </section>
    ))
  }
  {groups.length === 0 && <p class="empty">{emptyText}</p>}
</div>
{
  moreHref && (
    <a href={moreHref} class="more-link" id="all-posts-link">
      <span class="more-label">{moreLabel}</span>
      <span class="arrow" aria-hidden="true">→</span>
    </a>
  )
}
<div class="placeholder"></div>

<style>
  .post-list {
    display: flex;
    flex-direction: column;
    gap: 2.5rem;
  }

  .year-group {
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
  }

  .year {
    margin: 0 0 0.25rem 0;
    font-size: var(--font-size-s);
    font-weight: var(--font-weight-regular);
    color: var(--text-secondary);
    letter-spacing: var(--spacing-m);
    font-variant-numeric: tabular-nums;
  }

  .month-group {
    display: grid;
    grid-template-columns: 3rem 1fr;
    align-items: start;
  }

  .month {
    margin: 0;
    height: 2.5rem;
    display: flex;
    align-items: center;
    font-size: var(--font-size-s);
    font-weight: var(--font-weight-light);
    color: var(--text-tertiary);
    letter-spacing: var(--spacing-m);
  }

  ul {
    padding: 0;
    margin: 0;
    list-style-type: none;
    display: flex;
    flex-direction: column;
    min-width: 0;
  }

  .post-item {
    height: 2.5rem;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1.5rem;
    color: var(--text-primary);
    text-decoration: none;
    transition: opacity 0.15s ease-out;
  }

  .title {
    flex: 1 1 auto;
    min-width: 0;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .day {
    font-size: var(--font-size-s);
    color: var(--text-tertiary);
    opacity: 1;
    transition: color 0.15s ease-out;
  }

  @media (hover: hover) and (pointer: fine) {
    .post-list:hover .post-item {
      opacity: 0.4;
    }

    .post-list:hover .post-item:hover {
      opacity: 1;
    }

    .post-list:hover .post-item:hover .day {
      color: var(--text-secondary);
    }
  }

  .empty {
    margin: 0;
    font-size: var(--font-size-s);
    color: var(--text-secondary);
  }

  #all-posts-link,
  .more-link {
    align-self: flex-start;
    display: inline-flex;
    align-items: center;
    gap: 0.375rem;
    margin-top: 2rem;
    font-size: var(--font-size-s);
    color: var(--text-secondary);
    text-decoration: none;
    transition: color 0.15s ease-out;
  }

  #all-posts-link:visited,
  .more-link:visited {
    color: #999999;
    text-decoration: none;
  }

  :global(html.dark) #all-posts-link:visited,
  :global(html.dark) .more-link:visited {
    color: #777777;
    text-decoration: none;
  }

  .more-label {
    color: var(--text-secondary);
    text-decoration: none;
    transition: color 0.15s ease-out;
  }

  .arrow {
    display: inline-block;
    color: var(--text-secondary);
    transition: transform 0.2s ease-out, color 0.15s ease-out;
  }

  .more-link:hover .more-label,
  .more-link:hover .arrow,
  #all-posts-link:hover .more-label,
  #all-posts-link:hover .arrow {
    color: var(--text-primary);
  }

  .more-link:hover .arrow,
  #all-posts-link:hover .arrow {
    transform: translateX(3px);
  }

  .placeholder {
    height: 3rem;
  }
</style>
