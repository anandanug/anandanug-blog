---
import { getSortedFilteredPosts } from '@/utils/draft'
import FormattedDate from '@/components/widgets/FormattedDate.astro'

interface Props {
  currentSlug: string
  currentTags?: string[]
  maxPosts?: number
}

const { currentSlug, currentTags = [], maxPosts = 2 } = Astro.props

const allPosts = await getSortedFilteredPosts()
// Filter out the current active post
const otherPosts = allPosts.filter((post) => post.id !== currentSlug)

const normalizedCurrentTags = currentTags.map((t) => t.toLowerCase())

// Calculate relevance score based on common tags
const scoredPosts = otherPosts.map((post) => {
  const postTags = [
    ...(post.data.tags || []),
    ...(post.data.labels || []),
    ...(post.data.label ? [post.data.label] : [])
  ].map((t) => t.toLowerCase())

  let score = 0
  for (const tag of postTags) {
    if (normalizedCurrentTags.includes(tag)) {
      score += 1
    }
  }
  return { post, score }
})

// Sort primarily by relevance, secondarily by publication date
scoredPosts.sort((a, b) => {
  if (b.score !== a.score) {
    return b.score - a.score
  }
  return b.post.data.pubDate.valueOf() - a.post.data.pubDate.valueOf()
})

const relatedPosts = scoredPosts.slice(0, maxPosts).map((item) => item.post)
---

{
  relatedPosts.length > 0 && (
    <section class="related-section">
      <div class="related-header">
        <span class="related-title">Artikel Terkait</span>
        <div class="related-line" aria-hidden="true" />
      </div>

      <div class="related-grid">
        {relatedPosts.map((post) => {
          const postTags = [
            ...(post.data.tags || []),
            ...(post.data.labels || []),
            ...(post.data.label ? [post.data.label] : [])
          ]
          const displayTag = postTags[0]

          return (
            <a href={`/${post.id}/`} class="related-card">
              <div class="card-top">
                {displayTag && <span class="card-tag">{displayTag}</span>}
                <span class="card-arrow" aria-hidden="true">→</span>
              </div>
              <h4 class="card-title">{post.data.title}</h4>
              <div class="card-footer">
                <span class="card-date font-features">
                  <FormattedDate date={post.data.pubDate} context="list" />
                </span>
              </div>
            </a>
          )
        })}
      </div>
    </section>
  )
}

<style>
  .related-section {
    margin-top: 4.5rem;
    margin-bottom: 2rem;
    padding-top: 2rem;
  }

  .related-header {
    display: flex;
    align-items: center;
    gap: 1rem;
    margin-bottom: 1.5rem;
  }

  .related-title {
    font-size: var(--font-size-s);
    font-weight: var(--font-weight-bold);
    color: var(--text-tertiary);
    text-transform: uppercase;
    letter-spacing: 0.08em;
    flex-shrink: 0;
  }

  .related-line {
    flex: 1;
    height: 1px;
    background-color: var(--border);
  }

  .related-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
    gap: 1rem;
  }

  .related-card {
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    padding: 1.25rem;
    border: 1px solid var(--border);
    border-radius: 8px;
    text-decoration: none;
    color: var(--text-primary);
    background-color: transparent;
    transition: all 0.2s ease-out;
    min-height: 7.5rem;
  }

  .related-card:hover {
    background-color: var(--code-bg);
    border-color: var(--text-tertiary);
  }

  .card-top {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 0.75rem;
  }

  .card-tag {
    font-size: 0.6875rem;
    font-weight: 500;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: var(--text-secondary);
  }

  .card-arrow {
    font-size: var(--font-size-s);
    color: var(--text-tertiary);
    transition: transform 0.2s ease-out, color 0.2s ease-out;
  }

  .related-card:hover .card-arrow {
    transform: translateX(3px);
    color: var(--text-primary);
  }

  .card-title {
    margin: 0 0 1rem 0;
    font-size: var(--font-size-m);
    font-weight: var(--font-weight-bold);
    line-height: 1.45;
    color: var(--text-primary);
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .card-footer {
    display: flex;
    align-items: center;
    margin-top: auto;
  }

  .card-date {
    font-size: var(--font-size-s);
    color: var(--text-secondary);
    opacity: 0.75;
  }

  @media (max-width: 640px) {
    .related-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
