---
import IndexLayout from '@/layouts/IndexLayout.astro'
import { themeConfig } from '@/config'
---

<IndexLayout title={`Project · ${themeConfig.site.title}`} description={themeConfig.site.description}>
  <div class="project-content">
    <h1>Projects</h1>
    <p>My projects will be listed here. Check back soon for updates!</p>
  </div>
</IndexLayout>

<style>
  .project-content {
    max-width: 100%;
  }
  .project-content h1 {
    margin-bottom: 1rem;
  }
</style>

